        {
            "action": "get ip info",
            "identifier": "ipinfo",
            "description": "Retrieve threat intelligence information about an IP address",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "ip": {
                    "description": "IP address to look up",
                    "data_type": "string",
                    "required": true,
                    "primary": true,
                    "contains": [
                        "ip"
                    ],
                    "order": 0
                }
            },
            "output": [
                {
                    "data_path": "action_result.parameter.ip",
                    "data_type": "string",
                    "contains": [
                        "ip"
                    ],
                    "example_values": [
                        "8.8.8.8"
                    ]
                },
                {
                    "data_path": "action_result.status",
                    "data_type": "string",
                    "example_values": [
                        "success",
                        "failed"
                    ]
                },
                {
                    "data_path": "action_result.message",
                    "data_type": "string",
                    "example_values": [
                        "Successfully retrieved info for IP 8.8.8.8"
                    ]
                },
                {
                    "data_path": "action_result.summary.ip",
                    "data_type": "string",
                    "contains": [
                        "ip"
                    ],
                    "example_values": [
                        "8.8.8.8"
                    ]
                },
                {
                    "data_path": "action_result.data.*",
                    "data_type": "string",
                    "column_name": "Data",
                    "column_order": 0,
                    "example_values": [
                        ""
                    ]
                },
                {
                    "data_path": "summary.total_objects",
                    "data_type": "numeric",
                    "example_values": [
                        1
                    ]
                },
                {
                    "data_path": "summary.total_objects_successful",
                    "data_type": "numeric",
                    "example_values": [
                        1
                    ]
                }
            ],
            "render": {
                "type": "table",
                "title": "IP Information"
            },
            "versions": "EQ(*)"
        },
